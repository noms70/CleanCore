# ─── Secrets — never commit ────────────────────────────────
**/serviceAccountKey.json
**/*serviceAccount*.json
**/.env
**/.env.*
!**/.env.example

# ─── Python / Backend ──────────────────────────────────────
**/venv/
**/.venv/
venvmodel/
**/__pycache__/
*.py[cod]
Backend/runs/

# ─── Node / Admin panel ────────────────────────────────────
**/node_modules/
Admin_Panel/build/
Admin_Panel/dist/
**/*.tsbuildinfo
**/.firebase/
*.log

# ─── Flutter / mobile app ──────────────────────────────────
# NOTE: anchored to CleanCore/ because this repo is now rooted
# one level above the Flutter project.
CleanCore/build/
CleanCore/.dart_tool/
CleanCore/.flutter-plugins-dependencies
CleanCore/android/app/debug/
CleanCore/android/app/profile/
CleanCore/android/app/release/

# ─── Datasets & stock pretrained weights (not our source) ──
# Our *trained* models live in Backend/models/ and ARE tracked.
Datasets/
Datasets_v2/
industrial_dataset/
/yolov8s.pt
/yolo26n.pt
/*.zip

